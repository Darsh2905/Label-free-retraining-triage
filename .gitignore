# environment
.venv/
__pycache__/
*.pyc
.pytest_cache/

# data: regenerated by scripts/01_fetch_data.py (see README "Data acquisition")
# anchored to repo root so this does NOT also match src/data/ (the source package)
/data/

# results: regenerated by scripts/02-05 (see README "Reproduce"); cache/ especially
# (hundreds of MB of pickled models, keyed by config hash, purely an optimization)
/results/

# editor/OS noise
.DS_Store
.vscode/
.idea/

# background-job scratch logs (not part of the pipeline)
*.log

# LaTeX build leftovers (regenerated by tectonic; paper/main.bbl is rebuilt by `tectonic --keep-intermediates`)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.xdv
